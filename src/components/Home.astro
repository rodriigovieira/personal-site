---
import Base from "../layouts/Base.astro"
import ProjectCard from "./ProjectCard.astro"
import { copy, experience, profile, projects, stack, tools, type Lang } from "../data/content"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = copy[lang]
const mailto = `mailto:${profile.email}`
---

<Base lang={lang}>
  <div class="wrap">
    <nav class="top">
      <a class="brand" href={lang === "pt" ? "/pt/" : "/"}>Rodrigo Vieira</a>
      <div class="nav-links">
        <a href="#work">{t.nav.work}</a>
        <a href="#experience">{t.nav.experience}</a>
        <a href="#contact">{t.nav.contact}</a>
        <a class="lang" href={t.switchHref} hreflang={lang === "pt" ? "en" : "pt-BR"}>{t.switchLabel}</a>
      </div>
    </nav>

    <header class="hero">
      <div class="who">
        <img class="avatar" src="/img/avatar.webp" alt="Rodrigo Vieira" width="88" height="88" />
        <div>
          <p class="role">{t.role}</p>
        </div>
      </div>
      <h1>{t.headline}</h1>
      <p class="intro">{t.intro}</p>
      <div class="cta">
        <a class="btn primary" href={mailto}>{t.ctaPrimary}</a>
        <a class="btn" href="#work">{t.ctaSecondary}</a>
        <a class="btn icon-btn" href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6c.5-.9 1.6-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2ZM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2Zm1.8 13.1H3.6V9h3.5v11.5ZM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0Z"/></svg>
        </a>
        <a class="btn icon-btn" href={profile.github} target="_blank" rel="noopener" aria-label="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.9 18.3 5.2 18.3 5.2c.7 1.6.2 2.9.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"/></svg>
        </a>
      </div>

      <dl class="stats">
        {t.stats.map((s) => (
          <div>
            <dt>{s.value}</dt>
            <dd>{s.label}</dd>
          </div>
        ))}
      </dl>
    </header>

    <main>
      <section id="work">
        <h2>{t.projectsTitle}</h2>
        <p class="lead">{t.projectsLead}</p>
        <div class="grid">
          {projects.map((p) => <ProjectCard project={p} lang={lang} />)}
        </div>
        <div class="tools">
          {tools.map((tool) => (
            <a class="tool" href={tool.link} target="_blank" rel="noopener">
              <h3>{tool.name}</h3>
              <p>{tool.description[lang]}</p>
              <span>{tool.linkLabel[lang]} ↗</span>
            </a>
          ))}
        </div>
      </section>

      <section id="experience" class="split">
        <div>
          <h2>{t.experienceTitle}</h2>
          <ol class="timeline">
            {experience.map((job) => (
              <li>
                <div class="job-head">
                  <strong>{job.company}</strong>
                  <span class="period">{job.period}</span>
                </div>
                <p class="job-title">{job.title[lang]}</p>
                <p class="job-sum">{job.summary[lang]}</p>
              </li>
            ))}
          </ol>
        </div>
        <div>
          <h2>{t.stackTitle}</h2>
          <ul class="stack">
            {stack.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </section>

      <section id="contact" class="contact">
        <h2>{t.contactTitle}</h2>
        <p class="lead">{t.contactLead}</p>
        <div class="cta">
          <a class="btn primary" href={mailto}>{t.emailMe}</a>
          <a class="btn" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn" href={profile.github} target="_blank" rel="noopener">GitHub</a>
        </div>
        <p class="email"><a href={mailto}>{profile.email}</a></p>
      </section>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} Rodrigo Vieira</span>
      <span>{t.footer} <a href="https://github.com/rodriigovieira/personal-site" target="_blank" rel="noopener">GitHub</a>.</span>
    </footer>
  </div>
</Base>

<style>
  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
  }
  .brand {
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .nav-links {
    display: flex;
    gap: 1.25rem;
    font-size: 0.92rem;
  }
  .nav-links a {
    color: var(--muted);
    text-decoration: none;
  }
  .nav-links a:hover {
    color: var(--ink);
  }
  .nav-links .lang {
    color: var(--ink);
    font-weight: 600;
  }

  .hero {
    padding: 3.5rem 0 3rem;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
  }
  .role {
    margin: 0;
    font-weight: 600;
  }
  h1 {
    margin: 2rem 0 0;
    max-width: 18ch;
    font-size: clamp(2.3rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .intro {
    max-width: 60ch;
    margin: 1.25rem 0 0;
    font-size: 1.15rem;
    color: var(--muted);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem 1.2rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-weight: 600;
    text-decoration: none;
  }
  .btn.primary {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .btn:hover {
    opacity: 0.85;
  }
  .icon-btn {
    padding: 0.75rem;
  }
  .icon-btn svg {
    width: 20px;
    height: 20px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 3rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .stats dt {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .stats dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  section {
    padding: 3.5rem 0;
    border-top: 1px solid var(--line);
  }
  h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    letter-spacing: -0.025em;
  }
  .lead {
    margin: 0.5rem 0 0;
    max-width: 62ch;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.25rem;
  }
  .tool {
    display: block;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
    text-decoration: none;
  }
  .tool:hover {
    border-color: var(--muted);
  }
  .tool h3 {
    margin: 0;
    font-size: 1.15rem;
  }
  .tool p {
    margin: 0.4rem 0 0.8rem;
    color: var(--muted);
  }
  .tool span {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-ink);
  }

  .split {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3rem;
  }
  .timeline {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .timeline li {
    position: relative;
    padding: 0 0 1.5rem 1.4rem;
    border-left: 2px solid var(--line);
  }
  .timeline li::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 0.45rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .timeline li:last-child {
    padding-bottom: 0;
  }
  .job-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .period {
    color: var(--muted);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .job-title {
    margin: 0;
    font-size: 0.92rem;
    color: var(--accent-ink);
    font-weight: 600;
  }
  .job-sum {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .stack li {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    font-size: 0.92rem;
  }

  .contact {
    text-align: center;
    padding: 5rem 0;
  }
  .contact .lead {
    margin-left: auto;
    margin-right: auto;
  }
  .contact .cta {
    justify-content: center;
  }
  .email {
    margin-top: 1rem;
    color: var(--muted);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .grid,
    .tools,
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
    .split {
      gap: 2.5rem;
    }
  }
  @media (max-width: 560px) {
    .nav-links a:not(.lang) {
      display: none;
    }
    .hero {
      padding-top: 2rem;
    }
    .stats {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
